  "scriptName": "Render Status Panel",
  "findRegex": "/^<stats>\\s*(?<username>[^\\n]+)\\s*\\n[Oo]utfit:\\s*(?<outfit>[^\\n]+)\\s*\\n[Cc]ondition:\\s*(?<condition>[^\\n]+)\\s*(?:\\n[Ii]nventory:\\s*(?<inventory>[^\\n]+))?\\s*\\n[Ll]ocation:\\s*(?<location>[^\\n]+)\\s*\\n(?:\\.{3,})?(?<quote>[\\s\\S]+?)(?=\\n\\[)\\s*\\n\\[(?<time>[^\\]]+)\\]\\s*(?:\\n(?<name_and_icon1>[^\\n]+?)\\s*(?<favor1>\\S+\\s*-?\\d{1,3}%)\\s+(?:[Ss]tatus\\s+)?(?<fullstatus1>.+?)\\s*\\[(?<location1>[^\\]]+)\\])?(?:\\s*\\n(?<name_and_icon2>[^\\n]+?)\\s*(?<favor2>\\S+\\s*-?\\d{1,3}%)\\s+(?:[Ss]tatus\\s+)?(?<fullstatus2>.+?)\\s*\\[(?<location2>[^\\]]+)\\])?(?:\\s*\\n(?<name_and_icon3>[^\\n]+?)\\s*(?<favor3>\\S+\\s*-?\\d{1,3}%)\\s+(?:[Ss]tatus\\s+)?(?<fullstatus3>.+?)\\s*\\[(?<location3>[^\\]]+)\\])?(?:\\s*\\n(?<name_and_icon4>[^\\n]+?)\\s*(?<favor4>\\S+\\s*-?\\d{1,3}%)\\s+(?:[Ss]tatus\\s+)?(?<fullstatus4>.+?)\\s*\\[(?<location4>[^\\]]+)\\])?(?:\\s*\\n(?<name_and_icon5>[^\\n]+?)\\s*(?<favor5>\\S+\\s*-?\\d{1,3}%)\\s+(?:[Ss]tatus\\s+)?(?<fullstatus5>.+?)\\s*\\[(?<location5>[^\\]]+)\\])?(?:\\s*\\n(?<name_and_icon6>[^\\n]+?)\\s*(?<favor6>\\S+\\s*-?\\d{1,3}%)\\s+(?:[Ss]tatus\\s+)?(?<fullstatus6>.+?)\\s*\\[(?<location6>[^\\]]+)\\])?\\s*<\\/stats>/gmsi",
  "replaceString": "<!DOCTYPE html>\n<html>\n<head>\n<style>\nbody {\n  margin: 0;\n  padding: 5px;\n  background: linear-gradient(135deg, \n    var(--bg-gradient-1) 0%, \n    var(--bg-gradient-2) 35%, \n    var(--bg-gradient-3) 100%);\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.status-wrapper {\n  color: var(--text-primary);\n  font-family: 'Malgun Gothic', '맑은 고딕', sans-serif;\n  padding: 16px;\n  max-width: 500px;\n  width: 100%;\n  margin: 5px auto;\n  \n  background: var(--bg-secondary);\n  border: 1px solid var(--border-subtle);\n  border-radius: 16px;\n  box-shadow: \n    0 8px 32px var(--shadow-soft),\n    0 2px 8px rgba(0, 0, 0, 0.05),\n    inset 0 1px 0 var(--highlight-color);\n  \n  background-image: \n    radial-gradient(circle at 20% 20%, var(--accent-glow) 0%, transparent 50%),\n    radial-gradient(circle at 80% 80%, rgba(244, 123, 123, 0.03) 0%, transparent 50%);\n  \n  font-size: 13px;\n  line-height: 1.4;\n  position: relative;\n  \n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n}\n\n.status-wrapper::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: linear-gradient(90deg, \n    transparent 0%, \n    var(--highlight-color) 50%, \n    transparent 100%);\n  border-radius: 16px 16px 0 0;\n}\n\n.username {\n  color: var(--text-title);\n  font-size: 20px;\n  font-weight: 700;\n  margin: 0 0 10px 0;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\n}\n\n.info-line {\n  margin: 4px 0;\n  font-size: 12px;\n  color: var(--text-secondary);\n  padding: 4px 8px;\n  background: var(--bg-tertiary);\n  border-radius: 8px;\n  border: 1px solid var(--highlight-color);\n}\n\n.info-line strong {\n  font-weight: 600;\n  color: var(--text-primary);\n  margin-right: 8px;\n}\n\n.info-line[data-content=\"\"] {\n  display: none;\n}\n\n.user-quote {\n  font-style: italic;\n  color: var(--text-secondary);\n  text-align: center;\n  padding: 8px 12px;\n  margin: 8px 0;\n  font-size: 13px;\n  background: var(--bg-primary);\n  border-radius: 12px;\n  border-left: 3px solid var(--favor-neutral);\n  position: relative;\n  \n  background-image: linear-gradient(135deg, \n    rgba(244, 123, 123, 0.02) 0%, \n    transparent 50%);\n}\n\n.user-quote::before,\n.user-quote::after {\n  content: '\"';\n  font-size: 18px;\n  color: var(--text-tertiary);\n  opacity: 0.6;\n}\n\n.timestamp {\n  font-size: 11px;\n  color: var(--text-tertiary);\n  text-align: right;\n  margin-bottom: 10px;\n  white-space: nowrap;\n  padding: 4px 8px;\n  background: var(--timestamp-bg);\n  border-radius: 6px;\n  display: inline-block;\n  margin-left: auto;\n  width: fit-content;\n}\n\n.char-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  margin-top: 5px;\n}\n\n.char-item {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  grid-template-rows: auto auto auto;\n  align-items: center;\n  gap: 0px 10px;\n  padding: 8px;\n  background: var(--bg-tertiary);\n  border-radius: 10px;\n  border: 1px solid var(--border-subtle);\n  transition: all 0.2s ease;\n  position: relative;\n  overflow: hidden;\n}\n\n.char-item::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: linear-gradient(90deg, \n    var(--favor-neutral) 0%, \n    transparent 100%);\n  opacity: 0.6;\n  transition: background 0.3s ease;\n}\n\n.char-item:hover {\n  background: var(--bg-hover);\n  border-color: var(--border-hover);\n  transform: translateY(-1px);\n}\n\n.char-item[data-content=\"\"] {\n  display: none;\n}\n\n.char-name-icon {\n  grid-column: 1 / 2;\n  font-weight: bold;\n  font-size: 14px;\n  white-space: nowrap;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);\n}\n\n.char-favor {\n  grid-column: 2 / 3;\n  justify-self: end;\n  font-weight: bold;\n  font-size: 13px;\n  white-space: nowrap;\n  padding: 4px 8px;\n  border-radius: 6px;\n  background: var(--timestamp-bg);\n  transition: all 0.3s ease;\n}\n\n.char-status {\n  grid-column: 1 / 3;\n  color: var(--text-secondary);\n  font-size: 12px;\n  padding-top: 2px;\n  padding-left: 4px;\n  border-top: 1px solid var(--highlight-color);\n  margin-top: 2px;\n}\n\n.char-location {\n  grid-column: 1 / 3;\n  color: var(--text-tertiary);\n  font-size: 11px;\n  padding-left: 4px;\n  margin-top: 2px;\n}\n\n.char-location::before {\n  content: '📍 ';\n  opacity: 0.7;\n}\n\n.favor-symbol {\n  margin-right: 2px;\n  font-size: 14px;\n}\n</style>\n</script>\n</head>\n<body>\n<div class=\"status-wrapper\">\n  <div class=\"username\">$<username></div>\n  <p class=\"info-line\"><strong>복장:</strong> $<outfit></p>\n  <p class=\"info-line\"><strong>상태:</strong> $<condition></p>\n  <p class=\"info-line\" data-content=\"$<inventory>\"><strong>소지품:</strong> $<inventory></p>\n  <p class=\"info-line\"><strong>위치:</strong> $<location></p>\n  \n  <p class=\"user-quote\">$<quote></p>\n  <div class=\"timestamp\"><span>$<time></span></div>\n\n  <div class=\"char-list\">\n    <div class=\"char-item\" data-content=\"$<name_and_icon1>\">\n      <div class=\"char-name-icon\">$<name_and_icon1></div>\n      <div class=\"char-favor\">$<favor1></div>\n      <div class=\"char-status\">$<fullstatus1></div>\n      <div class=\"char-location\">$<location1></div>\n    </div>\n    <div class=\"char-item\" data-content=\"$<name_and_icon2>\">\n      <div class=\"char-name-icon\">$<name_and_icon2></div>\n      <div class=\"char-favor\">$<favor2></div>\n      <div class=\"char-status\">$<fullstatus2></div>\n      <div class=\"char-location\">$<location2></div>\n    </div>\n    <div class=\"char-item\" data-content=\"$<name_and_icon3>\">\n      <div class=\"char-name-icon\">$<name_and_icon3></div>\n      <div class=\"char-favor\">$<favor3></div>\n      <div class=\"char-status\">$<fullstatus3></div>\n      <div class=\"char-location\">$<location3></div>\n    </div>\n    <div class=\"char-item\" data-content=\"$<name_and_icon4>\">\n      <div class=\"char-name-icon\">$<name_and_icon4></div>\n      <div class=\"char-favor\">$<favor4></div>\n      <div class=\"char-status\">$<fullstatus4></div>\n      <div class=\"char-location\">$<location4></div>\n    </div>\n    <div class=\"char-item\" data-content=\"$<name_and_icon5>\">\n      <div class=\"char-name-icon\">$<name_and_icon5></div>\n      <div class=\"char-favor\">$<favor5></div>\n      <div class=\"char-status\">$<fullstatus5></div>\n      <div class=\"char-location\">$<location5></div>\n    </div>\n    <div class=\"char-item\" data-content=\"$<name_and_icon6>\">\n      <div class=\"char-name-icon\">$<name_and_icon6></div>\n      <div class=\"char-favor\">$<favor6></div>\n      <div class=\"char-status\">$<fullstatus6></div>\n      <div class=\"char-location\">$<location6></div>\n    </div>\n  </div>\n</div>\n</body>\n</html>",
